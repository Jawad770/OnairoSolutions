  updatedAt    DateTime    @updatedAt @map("updated_at")
  deletedAt    DateTime?   @map("deleted_at")
  item         CatalogItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([mediaType])
  @@index([displayOrder])
  @@map("catalog_media")
  @@schema("products")
}

model CatalogChangelog {
