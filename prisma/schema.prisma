model AiMessage {
  id             String         @id @default(uuid()) @db.Uuid
  conversationId String         @map("conversation_id") @db.Uuid
  role           String
  content        String         @db.Text
  toolName       String?        @map("tool_name")
  toolPayload    Json?          @map("tool_payload")
