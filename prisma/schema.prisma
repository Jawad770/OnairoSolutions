  deletedAt  DateTime?    @map("deleted_at")
  item       CatalogItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([itemId])
  @@index([enabled])
  @@map("catalog_campaigns")
  @@schema("products")
}

model CatalogNotifyInterest {
  id           String      @id @default(uuid()) @db.Uuid
  itemId       String      @map("item_id") @db.Uuid
  name         String?
  email        String?
  whatsapp     String?
  sourcePage   String?     @map("source_page")
  campaignSlug String?     @map("campaign_slug")
  leadId       Int?        @map("lead_id")
  metadataJson Json?       @map("metadata_json")
  createdAt    DateTime    @default(now()) @map("created_at")
  item         CatalogItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([email])
  @@index([createdAt])
  @@map("catalog_notify_interests")
  @@schema("products")
}

/// Immutable catalog content revision (not Downloads ProductVersion).
model CatalogRevision {
  id                  String                  @id @default(uuid()) @db.Uuid
  itemId              String                  @map("item_id") @db.Uuid
  versionNumber       Int                     @map("version_number")
  summary             String
  status              String                  @default("current")
  snapshotJson        Json                    @map("snapshot_json")
  createdByUserId     Int?                    @map("created_by_user_id")
  createdByEmail      String?                 @map("created_by_email")
  reason              String?
  ipHash              String?                 @map("ip_hash")
  userAgent           String?                 @map("user_agent")
  restoredFromVersion Int?                    @map("restored_from_version")
  createdAt           DateTime                @default(now()) @map("created_at")
  item                CatalogItem             @relation("ItemRevisions", fields: [itemId], references: [id], onDelete: Cascade)
  currentFor          CatalogItem[]           @relation("CurrentRevision")
  changes             CatalogRevisionChange[]

  @@unique([itemId, versionNumber])
  @@index([itemId])
  @@index([status])
  @@index([createdAt])
  @@map("catalog_revisions")
  @@schema("products")
}

model CatalogRevisionChange {
  id         String          @id @default(uuid()) @db.Uuid
  revisionId String          @map("revision_id") @db.Uuid
  entityType String          @map("entity_type")
  entityKey  String          @map("entity_key")
  field      String
  changeType String          @map("change_type")
  beforeJson Json?           @map("before_json")
  afterJson  Json?           @map("after_json")
  createdAt  DateTime        @default(now()) @map("created_at")
  revision   CatalogRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@index([revisionId])
  @@index([entityType])
  @@map("catalog_revision_changes")
  @@schema("products")
}

/// Full marketing campaigns (banners, scheduling, targeting). Distinct from light CatalogCampaign.
model MarketingCampaign {
  id                 String   @id @default(uuid()) @db.Uuid
  name               String
  slug               String   @unique
  internalNotes      String?  @map("internal_notes") @db.Text
  campaignType       String   @default("custom") @map("campaign_type")
  status             String   @default("draft")
  headline           String?
  subHeading         String?  @map("sub_heading")
  description        String?  @db.Text
  promotionBadge     String?  @map("promotion_badge")
  buttonText         String?  @map("button_text")
  buttonLink         String?  @map("button_link")
  bannerImageUrl     String?  @map("banner_image_url")
  backgroundImageUrl String?  @map("background_image_url")
  themeColor         String?  @map("theme_color")
  accentColor        String?  @map("accent_color")
  icon               String?
  animationStyle     String?  @map("animation_style")
  discountType       String?  @map("discount_type")
  discountValue      Decimal? @map("discount_value") @db.Decimal(12, 2)
  discountCode       String?  @map("discount_code")
  autoApplyDiscount  Boolean  @default(false) @map("auto_apply_discount")
  promotionId        String?  @map("promotion_id") @db.Uuid
  startsAt           DateTime? @map("starts_at")
  endsAt             DateTime? @map("ends_at")
  timezone           String   @default("Asia/Karachi")
  showCountdown      Boolean  @default(false) @map("show_countdown")
  bannerPlacement    String   @default("top_bar") @map("banner_placement")
  bannerScope        String   @default("entire_website") @map("banner_scope")
  dismissible        Boolean  @default(true)
  persistent         Boolean  @default(false)
  animated           Boolean  @default(true)
  audience           String   @default("all")
  utmSource          String?  @map("utm_source")
  utmMedium          String?  @map("utm_medium")
  utmCampaign        String?  @map("utm_campaign")
  trackingJson       Json?    @map("tracking_json")
  viewCount          Int      @default(0) @map("view_count")
  bannerClickCount   Int      @default(0) @map("banner_click_count")
  ctaClickCount      Int      @default(0) @map("cta_click_count")
  publishedAt        DateTime? @map("published_at")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")
  promotion          Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  products           MarketingCampaignProduct[]
  plans              MarketingCampaignPlan[]
  categories         MarketingCampaignCategory[]
  events             MarketingCampaignEvent[]

  @@index([status])
  @@index([startsAt])
  @@index([endsAt])
  @@index([deletedAt])
  @@map("marketing_campaigns")
  @@schema("products")
}

model MarketingCampaignProduct {
  id         String            @id @default(uuid()) @db.Uuid
  campaignId String            @map("campaign_id") @db.Uuid
  itemId     String            @map("item_id") @db.Uuid
  createdAt  DateTime          @default(now()) @map("created_at")
  campaign   MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  item       CatalogItem       @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([campaignId, itemId])
  @@index([itemId])
  @@map("marketing_campaign_products")
  @@schema("products")
}

model MarketingCampaignPlan {
  id         String            @id @default(uuid()) @db.Uuid
  campaignId String            @map("campaign_id") @db.Uuid
  planId     String            @map("plan_id") @db.Uuid
  createdAt  DateTime          @default(now()) @map("created_at")
  campaign   MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  plan       CatalogPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([campaignId, planId])
  @@index([planId])
  @@map("marketing_campaign_plans")
  @@schema("products")
}

model MarketingCampaignCategory {
  id         String            @id @default(uuid()) @db.Uuid
  campaignId String            @map("campaign_id") @db.Uuid
  categoryId String            @map("category_id") @db.Uuid
  createdAt  DateTime          @default(now()) @map("created_at")
  campaign   MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  category   CatalogCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([campaignId, categoryId])
  @@index([categoryId])
  @@map("marketing_campaign_categories")
  @@schema("products")
}

model MarketingCampaignEvent {
  id         String            @id @default(uuid()) @db.Uuid
  campaignId String            @map("campaign_id") @db.Uuid
  eventType  String            @map("event_type")
  pagePath   String?           @map("page_path")
  productSlug String?          @map("product_slug")
  sessionKey String?           @map("session_key")
  ipHash     String?           @map("ip_hash")
  metadataJson Json?           @map("metadata_json")
  createdAt  DateTime          @default(now()) @map("created_at")
  campaign   MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([eventType])
  @@index([createdAt])
  @@map("marketing_campaign_events")
  @@schema("products")
}

/// Discount / coupon promotions (not CatalogCampaign launch stubs).
model Promotion {
  id                String              @id @default(uuid()) @db.Uuid
  name              String
  code              String
  description       String?             @db.Text
  internalNotes     String?             @map("internal_notes") @db.Text
  discountType      String              @map("discount_type")
  discountValue     Decimal             @map("discount_value") @db.Decimal(12, 2)
  maxUses           Int?                @map("max_uses")
  usesPerCustomer   Int?                @default(1) @map("uses_per_customer")
  usedCount         Int                 @default(0) @map("used_count")
  applyAttemptCount Int                 @default(0) @map("apply_attempt_count")
  startsAt          DateTime?           @map("starts_at")
  endsAt            DateTime?           @map("ends_at")
  autoExpire        Boolean             @default(true) @map("auto_expire")
  status            String              @default("active")
  minPurchaseAmount Decimal?            @map("min_purchase_amount") @db.Decimal(12, 2)
  maxDiscountAmount Decimal?            @map("max_discount_amount") @db.Decimal(12, 2)
  currency          String              @default("PKR")
  kind              String              @default("coupon")
  stackingPolicy    Json?               @map("stacking_policy")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  deletedAt         DateTime?           @map("deleted_at")
  products          PromotionProduct[]
  plans             PromotionPlan[]
  redemptions       PromotionRedemption[]
  marketingCampaigns MarketingCampaign[]

  @@unique([code])
  @@index([status])
  @@index([endsAt])
  @@index([deletedAt])
  @@map("promotions")
  @@schema("products")
}

model PromotionProduct {
  id          String      @id @default(uuid()) @db.Uuid
  promotionId String      @map("promotion_id") @db.Uuid
  itemId      String      @map("item_id") @db.Uuid
  createdAt   DateTime    @default(now()) @map("created_at")
  promotion   Promotion   @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  item        CatalogItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([promotionId, itemId])
  @@index([itemId])
  @@map("promotion_products")
  @@schema("products")
}

model PromotionPlan {
  id          String      @id @default(uuid()) @db.Uuid
  promotionId String      @map("promotion_id") @db.Uuid
  planId      String      @map("plan_id") @db.Uuid
  createdAt   DateTime    @default(now()) @map("created_at")
  promotion   Promotion   @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  plan        CatalogPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([promotionId, planId])
  @@index([planId])
  @@map("promotion_plans")
  @@schema("products")
}

model PromotionRedemption {
  id               String    @id @default(uuid()) @db.Uuid
  promotionId      String    @map("promotion_id") @db.Uuid
  code             String
  itemId           String?   @map("item_id") @db.Uuid
  planId           String?   @map("plan_id") @db.Uuid
  leadId           Int?      @map("lead_id")
  customerEmail    String?   @map("customer_email")
  customerWhatsapp String?   @map("customer_whatsapp")
  originalAmount   Decimal   @map("original_amount") @db.Decimal(12, 2)
  discountAmount   Decimal   @map("discount_amount") @db.Decimal(12, 2)
  finalAmount      Decimal   @map("final_amount") @db.Decimal(12, 2)
  currency         String    @default("PKR")
  sourcePage       String?   @map("source_page")
  ipHash           String?   @map("ip_hash")
  userAgent        String?   @map("user_agent")
  createdAt        DateTime  @default(now()) @map("created_at")
  promotion        Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@index([promotionId])
  @@index([code])
  @@index([customerEmail])
  @@index([leadId])
  @@index([createdAt])
  @@map("promotion_redemptions")
  @@schema("products")
}

