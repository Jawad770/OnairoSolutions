  @@index([conversationId])
  @@index([createdAt])
  @@map("messages")
  @@schema("ai")
}

/* ===================== sandbox (products schema) ===================== */

/// Staging session — isolated catalog/marketing changes until publish.
model SandboxSession {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?  @db.Text
  status      String   @default("draft")
  createdById Int?     @map("created_by_id")
  publishedAt DateTime? @map("published_at")
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  changes     SandboxChange[]
  tokens      SandboxPreviewToken[]
  publishJobs SandboxPublishJob[]
  validations SandboxValidationReport[]

  @@index([status])
  @@index([deletedAt])
  @@index([createdById])
  @@map("sandbox_sessions")
  @@schema("products")
}

model SandboxChange {
  id           String         @id @default(uuid()) @db.Uuid
  sessionId    String         @map("session_id") @db.Uuid
  entityType   String         @map("entity_type")
  entityId     String?        @map("entity_id")
  entitySlug   String?        @map("entity_slug")
  changeType   String         @map("change_type")
  label        String?
  beforeJson   Json?          @map("before_json")
  afterJson    Json           @map("after_json")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  session      SandboxSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([entityType])
  @@index([entityId])
  @@map("sandbox_changes")
  @@schema("products")
}

model SandboxPreviewToken {
  id         String         @id @default(uuid()) @db.Uuid
  sessionId  String         @map("session_id") @db.Uuid
  token      String         @unique
  expiresAt  DateTime       @map("expires_at")
  revokedAt  DateTime?      @map("revoked_at")
  lastUsedAt DateTime?      @map("last_used_at")
  createdById Int?          @map("created_by_id")
  createdAt  DateTime       @default(now()) @map("created_at")
  session    SandboxSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([expiresAt])
  @@map("sandbox_preview_tokens")
  @@schema("products")
}

model SandboxPublishJob {
  id            String         @id @default(uuid()) @db.Uuid
  sessionId     String         @map("session_id") @db.Uuid
  status        String         @default("pending")
  publishMode   String         @default("replace") @map("publish_mode")
  scheduledFor  DateTime       @map("scheduled_for")
  timezone      String         @default("Asia/Karachi")
  startedAt     DateTime?      @map("started_at")
  completedAt   DateTime?      @map("completed_at")
  errorMessage  String?        @map("error_message") @db.Text
  createdById   Int?           @map("created_by_id")
  createdAt     DateTime       @default(now()) @map("created_at")
  session       SandboxSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([status])
  @@index([scheduledFor])
  @@map("sandbox_publish_jobs")
  @@schema("products")
}

model SandboxValidationReport {
  id           String         @id @default(uuid()) @db.Uuid
  sessionId    String         @map("session_id") @db.Uuid
  passed       Boolean        @default(false)
  warningCount Int            @default(0) @map("warning_count")
  errorCount   Int            @default(0) @map("error_count")
  reportJson   Json           @map("report_json")
  createdAt    DateTime       @default(now()) @map("created_at")
  session      SandboxSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([createdAt])
  @@map("sandbox_validation_reports")
  @@schema("products")
}
