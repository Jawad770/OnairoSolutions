{
  "name": "onairo-solutions",
  "version": "1.0.0",
  "description": "Premium website for Onairo Solutions — four pillars: client services (Build), industry websites (Launch), commercial software (Scale), and Shopify store design (Sell).",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js",
    "build:public": "node scripts/build-public.js && node scripts/fix-public-urls.js && node scripts/fix-path-helpers.js",
    "ai:build": "tsc -p server/ai/tsconfig.json",
    "seo:generate": "node scripts/generate-seo-pages.js",
    "landings:generate": "node scripts/generate-landings.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:parallel": "node --test tests/*.test.js",
    "verify:portal": "node scripts/verify-portal.js",
    "audit:responsive": "node scripts/responsive-audit.js",
    "audit:lighthouse": "node scripts/lighthouse-mobile.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "node scripts/db/migrate-from-json.js",
    "db:init": "node scripts/db/init.js",
    "db:backup": "node scripts/db/backup.js",
    "db:restore": "node scripts/db/restore.js",
    "db:studio": "prisma studio",
    "deploy": "bash ./deploy.sh",
    "backup": "bash ./backup.sh"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.3.0",
    "chart.js": "^4.5.1",
    "connect-pg-simple": "^10.0.0",
    "csrf-sync": "^4.2.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "openai": "^7.1.0",
    "pdfkit": "^0.19.1",
    "pg": "^8.22.0",
    "session-file-store": "^1.5.0",
    "tsx": "^4.23.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "chrome-launcher": "^1.2.1",
    "dotenv": "^17.4.2",
    "lighthouse": "^13.4.1",
    "playwright": "^1.62.0",
    "prisma": "^6.19.0",
    "typescript": "^7.0.2"
  }
}
