NODE_ENV=development
PORT=3000
PORTAL_ROUTE=/portal

# PostgreSQL — onairo_core (required)
DATABASE_URL=postgresql://portal_user:password@localhost:5432/onairo_core

# Session (required — use a long random string in production)
SESSION_SECRET=change-this-to-a-long-random-secret
SESSION_TIMEOUT_MINUTES=60
REMEMBER_ME_DAYS=14
MAX_LOGIN_FAILURES=5
LOCKOUT_MINUTES=20
INVITE_EXPIRY_HOURS=72
MIN_PASSWORD_LENGTH=10
LOGIN_RATE_LIMIT_MAX=20
FORM_RATE_LIMIT_MAX=30

# Paths (optional — defaults shown)
UPLOAD_DIR=./data/uploads
PUBLIC_DIRECTORY=./public
DEMO_DIRECTORY=./public/demos
SHOWCASE_DIRECTORY=./public/demos
BACKUPS_DIR=./backups
LOGS_DIR=./logs

# First-run admin seed (db:init)
INIT_ADMIN_EMAIL=admin@onairosolutions.com
INIT_ADMIN_PASSWORD=ChangeMeNow!123
# Only when set to 1/true, boot will overwrite the admin password from INIT_ADMIN_PASSWORD.
# Leave unset/false after first login so portal password resets are not undone on restart.
# INIT_ADMIN_FORCE_PASSWORD=0

# Behind nginx / Cloudflare set TRUST_PROXY=true
TRUST_PROXY=false
AUDIT_SALT=change-this-audit-salt

# Required in production:
# NODE_ENV=production
# SESSION_SECRET=<long-random-secret>
# TRUST_PROXY=true

# SMTP (optional but recommended for confirmation emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=hello@onairosolutions.com

# Onairo AI consultant
AI_ENABLED=true
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_RATE_LIMIT_MAX=40
AI_MAX_MESSAGE_LENGTH=2000
AI_MAX_MESSAGES=40
AI_CONVERSATION_RETENTION_DAYS=30

# Docker Compose extras
POSTGRES_USER=portal_user
POSTGRES_PASSWORD=onairo_portal_dev
POSTGRES_PORT=5432
